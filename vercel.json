{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api", "destination": "/docs/api" },
    { "source": "/api-3d", "destination": "/docs/api-3d" },
    { "source": "/api-effects", "destination": "/docs/api-effects" },
    { "source": "/api-mediapipe", "destination": "/docs/api-mediapipe" },
    { "source": "/api-nft-seed", "destination": "/docs/api-nft-seed" },
    { "source": "/api-skybox", "destination": "/docs/api-skybox" },
    { "source": "/api-sprites", "destination": "/docs/api-sprites" },
    { "source": "/api-voxel", "destination": "/docs/api-voxel" },
    { "source": "/api-xr", "destination": "/docs/api-xr" },
    { "source": "/assets", "destination": "/docs/assets" },
    { "source": "/audio", "destination": "/docs/audio" },
    { "source": "/blogs", "destination": "/docs/blogs" },
    { "source": "/collision", "destination": "/docs/collision" },
    { "source": "/editor", "destination": "/docs/editor" },
    { "source": "/font", "destination": "/docs/font" },
    { "source": "/framebuffer", "destination": "/docs/framebuffer" },
    { "source": "/fullscreen-button", "destination": "/docs/fullscreen-button" },
