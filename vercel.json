    { "source": "/os", "destination": "/docs/os" },
    { "source": "/physics", "destination": "/docs/physics" },
    { "source": "/screens", "destination": "/docs/screens" },
    { "source": "/storage", "destination": "/docs/storage" },
    { "source": "/textinput", "destination": "/docs/textinput" },
    { "source": "/ui", "destination": "/docs/ui" },
    { "source": "/wad", "destination": "/docs/wad" }
  ]
}
