# Neon Postgres connection string (Vercel Marketplace -> Neon -> free tier).
# Works identically for local dev and production; use a Neon branch per environment if desired.
DATABASE_URL="postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret used to HMAC-sign the anonymous visitor cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET="replace-with-a-random-64-char-hex-string"

# Public base URL used when generating QR code URLs. Production: https://s.starcade9.io
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Overrides every chapter's unlockDelaySeconds in non-production environments so
# countdown chapters can be tested without waiting 24 hours. Leave unset in production.
DEV_UNLOCK_DELAY_SECONDS="30"
